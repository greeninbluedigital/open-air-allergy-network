// Open Air Allergy Network — database schema
// See PROJECT_SPEC.md (Section 3, Data Model) for the source of truth this maps to.
// Lat/Long stay as plain Float columns here; a PostGIS `geography` column and GiST
// index are added in a follow-up raw-SQL migration and kept in sync by a trigger,
// since Prisma's schema language doesn't model PostGIS types directly (see
// prisma/migrations/*_add_postgis/migration.sql once generated).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Tier {
  FREE_CLAIMED
  VERIFIED
  FULL_PROFILE
  FEATURED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INACTIVE
}

// BLOG: /blog/[slug], timely/news-style, keeps the existing ungated
// "Contributed by" credit. LEARN: /learn-about-ilit/[slug] — the
// keyword-targeted comparison/education cluster pages (2026-09 SEO
// strategy), evergreen, "Last reviewed" date framing, gated credit (see
// Article.reviewApproved).
enum ArticleSection {
  BLOG
  LEARN
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  // Phase 2: a provider-login actor moves Draft -> Submitted; admin still does
  // final Approve/Publish. Modeled now so the enum doesn't need a migration later.
  SUBMITTED
}

/// PDP/SEM lead email verification (Section 4).
enum LeadConfirmationStatus {
  PENDING
  CONFIRMED
  // Auto-forwarded by the ~60-minute background job without a confirmation
  // click — still forwarded, just tagged differently, never silently dropped.
  UNVERIFIED_FORWARDED
}

/// One record per physical practice location. Sibling locations under the same
/// practice/doctor group share `groupId` (a plain string, not a separate table —
/// nothing besides the shared id is modeled at the group level today).
model Provider {
  id     String  @id @default(cuid())
  slug   String  @unique
  active Boolean @default(true)

  // Sales-demo listings (e.g. a "here's what a Featured PDP looks like"
  // example shown to a prospective client) — reachable only by knowing the
  // slug directly. Excluded from SRP search results and the sitemap, and
  // noindex/nofollow on its own PDP metadata (independent of robots.ts's
  // sitewide block, so this still holds once that's lifted for real launch).
  isDemo Boolean @default(false)

  groupId String?

  practiceName String

  address      String
  // Suite/floor/unit number, e.g. "Suite 200" — kept separate from `address`
  // so the geocoder only ever sees the street line (suite text can confuse
  // Mapbox's matching) while display code can still show both.
  addressLine2 String?
  city         String
  state        String
  zip          String
  // Auto-geocoded (Mapbox) by the sync job; only re-run when the address changes.
  latitude     Float?
  longitude    Float?
  // Derived by a DB trigger from latitude/longitude — see the init migration.
  // Never written directly; Unsupported so Prisma knows the column exists
  // without trying to manage its type.
  //
  // CAUTION: `prisma migrate dev` on a *new* schema change will propose dropping
  // "Provider_geog_idx" (the GiST index from the init migration) because it can't
  // see an index on an Unsupported column as schema-declared. Always inspect a
  // freshly generated migration with --create-only first and delete any
  // `DROP INDEX "Provider_geog_idx"` line before applying.
  geog         Unsupported("geography(Point, 4326)")?

  phone             String?
  website           String?
  // Where lead notifications get forwarded (Section 4's PDP/SEM email
  // verification flow) — distinct from the patient-facing phone/website;
  // never displayed publicly. Not called out explicitly in the spec's field
  // list for this feature, but forwarding a lead by email requires knowing
  // where to send it, so this is structurally necessary.
  notificationEmail String?

  tier Tier @default(FREE_CLAIMED)

  // Add-ons layered on top of whatever tier the provider already has — not
  // separate tiers themselves.
  foundingMember Boolean @default(false)
  geoExtension   Boolean @default(false)

  // One-time phone confirmation for Free-tier onboarding.
  verificationDate  DateTime?
  verificationNotes String?

  // Distinct from verificationDate: auto-updated by the daily sync — bumps to
  // today whenever subscriptionStatus = ACTIVE, freezes (stops updating) when
  // inactive. Verified-tier-and-up display only.
  verifiedAsOf DateTime?

  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  // Stripe Customer/Subscription ID.
  billingReference   String?
  nextBillingDate    DateTime?

  // Default 200; Geo-Extension providers are fixed at 600 (enforced in app logic,
  // not a DB constraint, since it's a business rule that can have exceptions).
  searchRadiusMiles Int @default(200)

  offersVideoConsult Boolean @default(false)
  offersPhoneConsult Boolean @default(false)

  shortBio    String?
  extendedBio String?

  // Portrait ~4:5 container, object-fit: cover on the frontend.
  photoUrl           String?
  secondaryPhotoUrls String[] @default([])
  // Separate from photoUrl on purpose — the SRP card's thumbnail is a small
  // square crop, and reusing the ~4:5 PDP photo there scaled/cropped badly.
  // Null renders nothing on the SRP card (no placeholder box) rather than
  // an empty box — a real design choice, not an oversight.
  srpPhotoUrl String?

  // Semicolon-segmented free text, e.g. "Tue-Fri: 8am-5pm; Sat: 9am-1pm" — parsed
  // for display, not normalized into rows (no fixed Mon-Sun grid).
  businessHours     String?
  ilitScheduleNotes String?

  // Single value today ("ILIT/Allergy"); a plain string (not an enum) so a future
  // second vertical doesn't require a migration.
  vertical String @default("ILIT/Allergy")

  // Patient Reviews module — Featured tier only (enforced in app logic, not
  // here), a deliberate top-tier differentiator. One master toggle for the
  // whole module; which platform(s) actually render is presence-based below
  // (Google shows if googlePlaceId is set, Yelp if any embed code or the
  // rating is set) rather than a separate per-platform flag.
  showReviews Boolean @default(false)

  // Google: Place Details API (up to 3 of the up to 5 review objects it
  // returns, algorithmically selected — no manual curation available).
  // Fetched by a daily cron (/api/reviews/refresh), not live per-request —
  // Place Details is billed per call, so caching is a cost control, not just
  // a performance one. googleRating/googleReviewCount are the place's
  // aggregate, distinct from any individual review's rating.
  googlePlaceId          String?
  googleRating           Float?
  googleReviewCount      Int?
  googleReviewsJson      Json?
  googleReviewsFetchedAt DateTime?

  // Yelp review excerpts: no API/data license — Yelp's own free, first-party
  // "Embed Review" feature generates these per review, manually picked and
  // pasted in. Exactly 3 slots (a real field limit, not just a guideline)
  // rather than an open-ended list.
  yelpEmbedCode1 String?
  yelpEmbedCode2 String?
  yelpEmbedCode3 String?

  // Yelp rating: the Fusion API's Business Info endpoint would give us this
  // as structured, auto-refreshed data the same way Google's does above, but
  // Yelp's API is a paid product ($230+/mo minimum) — not worth it yet at
  // this scale. yelpRatingBadgeEmbed is the free interim path: Yelp's own
  // free rating-badge widget (or a third-party one), pasted in the same way
  // as the review embeds above, self-updating on Yelp's end at zero cost.
  // yelpBusinessId/yelpRating/yelpReviewCount/yelpReviewsFetchedAt exist now
  // so switching on the paid API later is just setting YELP_API_KEY —
  // /api/reviews/refresh already has the Yelp branch wired (see
  // src/lib/yelpReviews.ts), it just no-ops without a key, same as Google
  // does without GOOGLE_PLACES_API_KEY. yelpRatingBadgeEmbed naturally stops
  // being read once yelpRating starts being populated by the cron.
  yelpRatingBadgeEmbed   String?
  yelpBusinessId         String?
  yelpRating             Float?
  yelpReviewCount        Int?
  yelpReviewsFetchedAt   DateTime?

  // Facebook remains excluded — still gated behind Meta App Review and
  // per-practice OAuth. Reserved so turning it on later is additive.
  showFacebookReviews Boolean @default(false)
  facebookPageId      String?

  customField1  String?
  customField2  String?
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treatments         ProviderTreatment[]
  badges             ProviderBadge[]
  faqItems           ProviderFaqItem[]
  semLandingPages    SemLandingPage[]
  creditedArticles   Article[]           @relation("ArticlesCredited")
  authors            AuthorProvider[]
  contactSubmissions ContactSubmission[]
  analyticsEvents    AnalyticsEvent[]

  @@index([groupId])
  @@index([tier])
  @@index([active])
  @@index([city, state])
}

/// Canonical treatments list, scoped per Vertical, normalized from the Sheet's
/// semicolon-entry field on sync. Powers the future SRP treatment filter.
model Treatment {
  id       String @id @default(cuid())
  vertical String @default("ILIT/Allergy")
  name     String
  slug     String

  providers ProviderTreatment[]

  @@unique([vertical, slug])
}

model ProviderTreatment {
  providerId  String
  treatmentId String

  provider  Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@id([providerId, treatmentId])
  @@index([treatmentId])
}

/// Independent booleans, not tier-derived — a flexible badge slot rather than a
/// hardcoded fixed set. `type` is a free string (not an enum) so a new badge type
/// (e.g. a future promo variant) doesn't require a migration. Founding Member has
/// its own canonical boolean on Provider (it drives the exclusivity radius check);
/// it is not duplicated here.
model ProviderBadge {
  id         String    @id @default(cuid())
  providerId String
  // Known values today: "featured", "new", "verified_trust", "promo".
  type       String
  label      String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

/// PDP FAQ — distinct from the Article FAQ. Provider-scoped, Full Profile-and-up
/// only (enforced in app logic, not here), ~8-10 questions as a soft practical cap.
model ProviderFaqItem {
  id         String @id @default(cuid())
  providerId String
  question   String
  answer     String
  sortOrder  Int    @default(0)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

/// A real entity, not article-level duplicate fields — stored once, referenced by
/// every article that person writes. Can link to more than one Provider (a doctor
/// practicing at multiple locations).
model Author {
  id   String @id @default(cuid())
  // Sheet-managed via the "Practitioners" tab (upsert-by-key), unlike the
  // rest of Author, which is still a direct DB write — see
  // docs/blog-content-guide.md.
  slug String @unique
  name String
  photoUrl String?
  bio      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providers AuthorProvider[]
  articles  Article[]
}

model AuthorProvider {
  authorId   String
  providerId String

  author   Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([authorId, providerId])
  @@index([providerId])
}

model Article {
  id      String         @id @default(cuid())
  status  ArticleStatus  @default(DRAFT)
  section ArticleSection @default(BLOG)
  slug    String         @unique

  // Nullable — house content may have no specific named author.
  authorId String?
  author   Author? @relation(fields: [authorId], references: [id])

  // Explicit field, not derived from the Author's location list — determines the
  // PDP cross-link and which PDP's "Articles by This Practice" module shows it.
  providerCreditedId String?
  providerCredited   Provider? @relation("ArticlesCredited", fields: [providerCreditedId], references: [id])

  // LEARN-section only: the "Medically reviewed by" credit box only renders
  // when this is explicitly true, independent of authorId/providerCreditedId
  // being set — lets a credit be staged (author + provider linked) before
  // there's documented approval to actually show it, and lets it be flipped
  // off in one sync run if a Featured subscription lapses, without deleting
  // the underlying links. Sheet-managed via the "Learn Page Credits" tab.
  // Not used by BLOG-section articles (their "Contributed by" credit stays
  // ungated, unchanged from before this field existed).
  reviewApproved Boolean @default(false)

  // Freeform, counted/sorted by frequency for the Blog's tag filter — a plain
  // array rather than a normalized Tag table, since tags are intentionally
  // uncontrolled free text.
  tags String[] @default([])

  title String
  // Markdown — supports headings, bold/italic, bullet/numbered lists, and
  // inline images (standard `![alt](url)` syntax is how a second/third
  // photo goes mid-article; no separate "secondary image" field needed).
  body  String

  // Optional "Key Takeaways" bullets rendered in a callout box right after
  // the title, before the body — the news-article-summary pattern. No
  // dedicated schema.org type exists for this the way FAQPage does; the
  // SEO/GEO value is mostly about giving both human skimmers and AI
  // summarizers a concise, quotable set of facts near the top, not a
  // structured-data signal. Still folded into the JSON-LD `abstract`
  // property below for a legitimate (if minor) structured-data nod.
  summaryPoints String[] @default([])

  // Contribution articles: optional, article-specific — never auto-inherited from
  // the Provider's PDP photo (multi-doctor practices need per-author accuracy).
  featureImageUrl String?
  // Falls back to a generic silhouette in the UI if unset — never to the
  // practice's general PDP photo, for the same multi-doctor-accuracy reason.
  authorPhotoUrl  String?

  // Admin-settable — locks the article into a specific Article Feed slot
  // regardless of recency. A free string identifying the feed instance (e.g.
  // "homepage_recent", "learn_about_ilit_clinical", "blog_featured") rather than
  // an enum, since new Article Feed instances are expected to keep appearing.
  pinnedTo String?

  publishedDate DateTime?
  lastUpdated   DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  faqItems ArticleFaqItem[]

  @@index([status])
  @@index([section])
  @@index([providerCreditedId])
  @@index([authorId])
  @@index([publishedDate])
}

/// Same Q&A structure as the PDP FAQ, Article-scoped, entirely optional.
model ArticleFaqItem {
  id        String @id @default(cuid())
  articleId String
  question  String
  answer    String
  sortOrder Int    @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

/// A Provider can have zero, one, or many SEM landing pages (Geo-Extension: one
/// per target metro). noindex + excluded from the sitemap — enforced by the page
/// itself, not the schema.
model SemLandingPage {
  id              String  @id @default(cuid())
  providerId      String
  targetMetroName String
  travelNarrative String?
  // e.g. "sf-bay-area" — unique per provider (route is
  // /lp/[provider.slug]/[urlSlug]), not globally. A global @unique here would
  // mean only one provider site-wide could ever use a given metro slug.
  urlSlug         String
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, urlSlug])
  @@index([providerId])
}

/// Singleton row (id fixed at 1) for the handful of global, site-wide values that
/// don't belong to any one entity.
model SiteSetting {
  id Int @id @default(1)

  // Global shared field, reused across every SEM landing page for every practice.
  semHeroBlurb String @default("")

  // PAF config flag (Section 4): house articles (no location) stay included when
  // a PAF radius filter is active, unless this is flipped on later.
  excludeHouseArticlesWhenPafActive Boolean @default(false)
}

/// PDP "tracked contact form" submissions (Full Profile+ only). Logs Provider
/// ID + UTM data, per Section 2's analytics requirement — this is the minimal
/// real persistence for that specific paid feature; the broader GA4 + internal
/// page-view/phone-click events log is separate, larger, and not built yet.
model ContactSubmission {
  id         String @id @default(cuid())
  providerId String

  firstName String
  lastName  String
  email     String
  phone     String?
  message   String

  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  // Two-stage lead email verification (Section 4), PDP + SEM landing page
  // forms specifically. Stage 1 (MX/domain check) happens before a row is
  // ever created — a structurally-undeliverable address is rejected inline
  // at submission, never persisted. Everything below is Stage 2.
  confirmationToken  String                 @unique @default(cuid())
  confirmationStatus LeadConfirmationStatus @default(PENDING)
  // Set when the patient clicks the confirmation link.
  confirmedAt        DateTime?
  // Set once the lead is actually forwarded to the practice — either at
  // confirmation click (tagged [Verified]) or by the ~60-minute background
  // job (tagged [Unverified]), whichever comes first. Null until forwarded.
  forwardedAt        DateTime?

  createdAt DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([confirmationStatus, createdAt])
}

enum AnalyticsEventType {
  PAGE_VIEW
  PHONE_CLICK
}

/// Internal events log (PROJECT_SPEC.md's Analytics section) — provider-scoped
/// page views and phone clicks, UTM-tagged, feeding a future per-practice
/// reporting view (Featured tier's "analytics reporting" perk) and SEM
/// campaign performance. Deliberately narrower than a general web-analytics
/// tool: GA4 (via GTM, see NEXT_PUBLIC_GTM_ID) already covers sitewide
/// traffic, so this only tracks what needs to survive independently of GA4
/// for our own product — form submissions are already fully covered by
/// ContactSubmission (createdAt/confirmedAt/forwardedAt + UTM), not
/// duplicated here.
model AnalyticsEvent {
  id         String             @id @default(cuid())
  type       AnalyticsEventType
  providerId String
  path       String

  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  createdAt DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, type, createdAt])
}

/// For Practices page lead capture — not tied to an existing Provider (the
/// practice usually doesn't have a listing yet). High-touch sales
/// conversation starter per Section 1, not self-service signup.
model PracticeLead {
  id String @id @default(cuid())

  firstName    String
  lastName     String
  practiceName String
  email        String
  phone        String
  phoneExt     String?
  city         String
  state        String
  comments     String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  createdAt DateTime @default(now())
}

/// About page's general contact form — distinct from PracticeLead (practice
/// signup) and ContactSubmission (patient-to-provider): the catch-all for
/// press, partnerships, and what the Accessibility Statement footer page
/// points to. Section 5.
model GeneralInquiry {
  id String @id @default(cuid())

  firstName String
  lastName  String
  email     String
  // "General Inquiry" | "Press / Media" | "Partnership" | "Accessibility" | "Other"
  reason    String
  message   String

  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  createdAt DateTime @default(now())
}

/// The six footer legal pages (Section 9's SEM MinimalFooter carries two of
/// these — Privacy Notice, Terms — as the minimum a data-collecting form
/// legally needs). Content lives here, not in code, specifically so the
/// site owner can edit it directly (Prisma Studio, or straight SQL) as
/// counsel reviews it, without a git commit + redeploy per wording change.
model LegalPage {
  /// Matches the /legal/[slug] route segment and the footer's LEGAL_LINKS.
  slug     String @id
  title    String
  /// Trusted, owner/counsel-authored HTML — same trust boundary as
  /// extendedBio/Yelp embeds elsewhere in this schema, not end-user input.
  bodyHtml String

  updatedAt DateTime @updatedAt
}
